# ----------------------------------------------------------------------------
# Laravel API (single backend for all tenants)
# Include the route prefix, e.g. routes/api.php -> /api
# ----------------------------------------------------------------------------
LARAVEL_API_URL=https://api.laravel.dev/api
LARAVEL_TIMEOUT_MS=15000

# ----------------------------------------------------------------------------
# Auth cookie (stores the Sanctum token, AES-GCM encrypted, HttpOnly)
# Generate: openssl rand -base64 48
# ----------------------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
AUTH_COOKIE_NAME=tenant_auth
AUTH_COOKIE_MAX_AGE=2592000
# AUTH_COOKIE_SECURE=true   # defaults to true in production

# Refresh token (POST v1/user/refresh-token) when it expires within N seconds
# (only if Laravel returns expires_at / expires_in with the token).
TOKEN_REFRESH_THRESHOLD=86400

# ----------------------------------------------------------------------------
# Tenancy
# ----------------------------------------------------------------------------
# GET {LARAVEL_API_URL}/v1/tenants/check?domain=<request host>
TENANT_CHECK_PATH=v1/tenants/check
TENANT_CHECK_PARAM=domain
# Headers sent on every server -> Laravel request
TENANT_HEADER=X-Tenant
TENANT_DOMAIN_HEADER=X-Tenant-Domain
TENANT_CACHE_TTL=300
TENANT_NEGATIVE_CACHE_TTL=30

# Trust X-Forwarded-* headers (ONLY behind a trusted proxy / load balancer)
TRUST_PROXY=false

# DEV ONLY: treat every request as coming from this tenant host (localhost)
DEV_TENANT_DOMAIN=acme.example.com

# ----------------------------------------------------------------------------
# Client (exposed to the browser)
# ----------------------------------------------------------------------------
VITE_SOCIAL_PROVIDERS=google,github
